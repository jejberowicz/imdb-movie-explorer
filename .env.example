# Copy to .env to override the defaults of docker-compose.yml. Never commit the .env file.

# Password of the local database. The database is not published outside the Docker network.
POSTGRES_PASSWORD=change-me

# Ports published on this machine
API_PORT=8000
WEB_PORT=8080

# Gunicorn workers of the API
GUNICORN_WORKERS=2

# Requests per minute per client IP. In memory, each worker counts on its own (docs/security-plan.md)
RATE_LIMIT=300 per minute
