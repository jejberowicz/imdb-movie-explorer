# Copy to .env to override the defaults of docker-compose.yml. Never commit the .env file.

# Passwords of the local database, which is not published outside the Docker network: the superuser (only for
# administering, from inside the db container), the owner (migrations and load) and the read-only user of the
# API. They apply when the database is created; to change them later, run docker compose down -v first.
# Avoid @ : / # and spaces in them: they go inside a connection URL.
POSTGRES_PASSWORD=change-me
MOVIES_DB_PASSWORD=change-me-too
API_DB_PASSWORD=change-me-as-well

# Ports published on this machine
API_PORT=8000
WEB_PORT=8080

# Gunicorn workers of the API
GUNICORN_WORKERS=2

# Requests per minute per client IP. In memory, each worker counts on its own (docs/security-plan.md)
RATE_LIMIT=300 per minute
